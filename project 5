    {
        printf("File cannot be opened");
        return;
    }

    fprintf(fp, "I am rawoof from cse dept at first c program was very difficult for me after aravind sir came for our c programming class and now i am understant it easily and now sir teach very well sir was very good in teach thank you sir");

